programa
{
	
	funcao inicio()
	{
		inteiro x, dobro
		cadeia nome
		real metade
		
		//escreva("Olá Mundo.\n")

		escreva("Digite seu nome: ")
		leia(nome)
		escreva("Meu nome é ",nome,".\n")
		
		// ===============================
		x = 15
		escreva("O valor de x é ", x ,".\n")

		// ===============================
		escreva("Infome o valor: ")
		leia(x)
		escreva("O valor de x é ", x ,".\n")

	 	dobro = x * 2
	 	escreva("O dobro de x é ", dobro, ".\n")

	 	metade = x / 2.0
	 	escreva("A metade de x é ", metade, ".\n")
		
		
	}
	
}

