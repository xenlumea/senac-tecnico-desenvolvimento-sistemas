	// 3) Faça um algoritmo que exiba o seu nome, a sua idade e o preço do seu tênis. Exiba também a frase “Fim do Programa”.
	funcao inicio()
	{
		 escreva("Emanuel.\n")
		 escreva(26, ".\n")
		 escreva(120.50 ,".\n")
