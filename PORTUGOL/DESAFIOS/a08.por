programa
{
	 /*
	 8) Faça um algoritmo que leia um número. Exiba “igual a 10” se este número lido for igual a 10.
	 */
	
	funcao inicio()
	{
		inteiro numero
		escreva("Digite um número: ")
		leia(numero)

		se(numero == 10){
			escreva("Igual a 10.")
		}
	 
	}
}
