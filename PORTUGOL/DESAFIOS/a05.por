programa
{
	// 5) Faça um algoritmo que atribua o número 10 a uma variável e exiba seu valor. 
	// Acrescente 5 a esta variável e exiba seu valor.
	// Multiplique o valor da variável por 3 e exiba seu valor.

	funcao inicio()
	{
		inteiro numero = 10
		escreva(numero, "\n")
		 
		numero = numero + 5
		escreva(numero, "\n")

		numero = numero * 3
		escreva(numero, "\n")
		 
	}
}
