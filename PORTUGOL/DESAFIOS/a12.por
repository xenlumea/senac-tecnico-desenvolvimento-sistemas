programa
{
	 /*
	 12) Faça um algoritmo que leia o sexo (‘F’ ou ‘M’). 
	 Exiba “Feminino” se esta variável for igual a ‘F’ , senão exiba “Masculino”.

	 */
	
	funcao inicio()
	{
		caracter sexo  
		
		escreva("Digite F para FEMININO ou M para MASCULINO: ")
		leia(sexo)

		se(sexo=='F'){
			escreva("Feminino")
		}senao{
			escreva("Masculino")
		}
	 
	}
}
