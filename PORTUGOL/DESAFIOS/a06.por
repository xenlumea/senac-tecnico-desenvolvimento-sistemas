programa
{
	// 6) Faça um algoritmo que possua as variáveis x, y e z.
	// Atribua 10 à variável x e 5 à variável y. 
	// Calcule e exiba a soma, a subtração e a multiplicação das variáveis x e y. 
	// Atribua à variável z divisão de x e y e exiba na tela.
	
	funcao inicio()
	{
		real x , y , z , soma, subtracao, multiplicacao
		 		
		x = 10.0
		y = 5.0
	
		soma = x + y
		subtracao = x - y
		multiplicacao = x * y
		
		z = x / y
				
		escreva("Soma = ", soma , "\n")
		escreva("Subtracao = ", subtracao , "\n")
		escreva("Multiplicacao = ", multiplicacao , "\n")
		escreva("Divisão = ", z , "\n")
	}
}
