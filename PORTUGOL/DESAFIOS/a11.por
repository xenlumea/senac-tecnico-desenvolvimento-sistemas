programa
{
	 /*
	 11) Faça um algoritmo que leia um número. 
	 Exiba “Maior que 10” se este número for maior que 10, 
	 senão exiba “Não é maior que 10”.

	 */
	
	funcao inicio()
	{
		inteiro numero1 
		
		escreva("Digite um número: ")
		leia(numero1)

		se(numero1 > 10){
			escreva("Maior que 10")
		}senao{
			escreva("Não é maior que 10")
		}
	 
	}
}
