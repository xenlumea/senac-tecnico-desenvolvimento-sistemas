programa
{
	// 4) Faça um algoritmo que leia uma variável numérica com o valor da sua idade. 
	// Escreva seu nome e a sua idade (que está na variável).
	funcao inicio()
	{
		 inteiro idade
		 escreva("Digite sua idade: ")
		 leia(idade)

		 escreva("Emanuel, ", idade ," anos.\n")
		 
		 
	}
}
